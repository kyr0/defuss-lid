#!/bin/sh
# Reject AI co-author trailers. Maintainer rule: an AI assistant never appears as a co-author in this history.
# Activated by `make setup` (git config core.hooksPath .githooks); scripts/verify.mjs also scans the existing history.
if grep -qiE '^[[:space:]]*co-authored-by:.*(claude|anthropic)' "$1"; then
  echo "commit-msg: remove the AI Co-Authored-By trailer; this repository does not list AI assistants as co-authors." >&2
  exit 1
fi
