# Optional development settings; copy to .env (gitignored). The Makefile exports these to every recipe.
# Port of `bun run serve` (website at http://127.0.0.1:$PORT/docs/).
PORT=8080
# Playwright server port for `bunx playwright test` (scripts/e2e.mjs picks a free random port itself).
E2E_PORT=4317
# 1 = let browser tests fetch models from Hugging Face instead of the local, hash-identical copies.
E2E_LIVE=
# 1 = run scripts/e2e.mjs without the Playwright browsers (Node, Bun and Python only).
E2E_SKIP_BROWSERS=
# Server root for Playwright; set by scripts/e2e.mjs to tmp/e2e/www. Leave empty to serve the checkout.
E2E_ROOT=
# Rounds per sentence for `make bench`.
ROUNDS=200
# Python reproduction scripts: single-threaded BLAS keeps fitted codebooks reproducible across machines.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
